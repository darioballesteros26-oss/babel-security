{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Security Babel",
  "version": "0.2.1",
  "identifier": "com.security.babel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "Security Babel",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http://127.0.0.1:5002; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; frame-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/servidor_babel"
    ],
    "resources": [
      "binaries/pdfium/*",
      "modelos_usb/small100-int8/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MDdFN0I2QTlDRkRBNTQKUldSVTJzK3B0dWNINlYzL2FCK0gwQnlWdEVDTTNyVWRVc2toelIrYy9JVlNPZk5jQVZkZ3ZYSVUK",
      "endpoints": [
        "https://github.com/darioballesteros26-oss/babel-security/releases/latest/download/latest.json"
      ]
    },
    "shell": {
      "open": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "babel"
        ]
      }
    }
  }
}