{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    { "identifier": "opener:allow-open-path", "allow": [{"path": "$HOME/Babel/**"}] },
    "shell:allow-open",
    "dialog:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
